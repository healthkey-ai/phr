# Django
SECRET_KEY=change-me-in-production-use-django-secret-key-generator
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (PostgreSQL in production, SQLite for dev)
# DATABASE_URL=postgres://user:password@localhost:5432/healthkey
DATABASE_URL=sqlite:///db.sqlite3

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# ── Lab upload (Phase 2c+) ──────────────────────────────────────────────────
# Feature flag: disable in prod until the chosen-provider BAA is on file.
LAB_UPLOAD_ENABLED=True

# LLM provider for extraction. "claude" (default) or "openai".
LAB_LLM_PROVIDER=claude

# Set the key for whichever provider you selected above. The other can stay
# blank. The task raises ExtractionError on first call if the selected
# provider's key is missing.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the OpenAI model. gpt-4o gives the best accuracy on
# lab reports; gpt-4o-mini is cheaper and still works on clean typeset PDFs.
LAB_OPENAI_MODEL=gpt-4o

# Celery: leave empty for local dev (eager mode). Set to your Redis URL in prod.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Shared object storage (required in prod where web + worker run in
# separate containers) ──────────────────────────────────────────────────────
# Precedence: GCS > S3 > FileSystemStorage (dev default).
# Pick one — setting both just means S3 is ignored.

# Google Cloud Storage (cancerbot-healthkey-patient-dev | cancerbot-healthkey-patient-prod)
GS_BUCKET_NAME=
GS_PROJECT_ID=
# Option A: paste the full service-account key JSON as the value (multi-line
# allowed in .env — most tools support it).
# Option B: leave GS_CREDENTIALS_JSON blank and set GOOGLE_APPLICATION_CREDENTIALS
# to a path on disk (most common for local dev with gcloud CLI auth).
GS_CREDENTIALS_JSON=

# S3-compatible (AWS, Cloudflare R2, Backblaze B2)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only set for non-AWS S3-compatible endpoints (e.g. R2):
#   AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
AWS_S3_ENCRYPTION=AES256
