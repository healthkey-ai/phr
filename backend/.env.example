# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database — point at your locally running Postgres. Create the role + db:
#   psql -d postgres -c "CREATE ROLE phr LOGIN PASSWORD 'phr_dev_password'"
#   createdb -O phr phr
DATABASE_URL=postgres://phr:phr_dev_password@127.0.0.1:5432/phr

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT — phr is the identity provider for the HealthKey service family.
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7
JWT_ISSUER=healthkey-phr

# RS256 keypair (PEM). When set, tokens are signed RS256 and sibling services
# verify them offline via GET /api/v1/auth/jwks/. Leave blank for local dev
# (HS256 with SECRET_KEY; siblings must use POST /api/v1/auth/introspect/).
# Generate with:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
