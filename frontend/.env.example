# Dev proxy target — the Django backend (see backend/.env).
VITE_API_PROXY_TARGET=http://localhost:9000

# hk-labs service API (used by federated labs components via useLabsApi).
VITE_LABS_API_URL=http://localhost:9100/api/v1

# Module Federation remote (remoteEntry.js origin) for hk-labs components.
VITE_LABS_REMOTE_URL=http://localhost:5175

# promop service (patient record / PatientInfo remote).
VITE_PROMOP_API_URL=http://localhost:9200/api
VITE_PROMOP_REMOTE_URL=http://localhost:3001
