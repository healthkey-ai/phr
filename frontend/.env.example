# HealthKey frontend — environment variables
# Copy this file to `.env` (or `.env.local` for per-developer overrides) and edit.
#
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# All variables here have sensible defaults in code, so you can run the app
# without any .env file at all.

# ── API endpoint ──────────────────────────────────────────────────────────────
# Where the React app talks to the Django backend.
#
# In dev, leave this as `/api/v1`. The Vite dev server proxies that prefix to
# VITE_API_PROXY_TARGET below, which avoids CORS preflights and keeps cookies
# clean.
#
# In production builds, set this to the absolute URL of your API gateway,
# e.g. `https://api.healthkey.io/api/v1`. CORS must be configured on Django to
# accept the production origin.
VITE_API_URL=/api/v1

# ── Dev proxy target ──────────────────────────────────────────────────────────
# Only used by the Vite dev server (not bundled into the production build).
# This is the host:port where Django is running locally.
#
# `localhost` works because vite.config.ts calls
# `dns.setDefaultResultOrder("ipv4first")` to force IPv4 resolution before
# IPv6 (Django's dev server only binds to IPv4 by default).
VITE_API_PROXY_TARGET=http://localhost:8000
